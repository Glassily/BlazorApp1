@using BlazorApp1.Services
@inject MarkdownService Mds
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<div id="@containerId" class="markdown-body preview-content">
    @((MarkupString)MarkdownContent)
</div>

@code {

    [Parameter]
    public string? Content { get; set; } = string.Empty;

    [Parameter]
    public string? Source { set; get; } = string.Empty;

    private string containerId = $"md-" + Guid.NewGuid().ToString("N");

    private string MarkdownContent = string.Empty;


    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Source))
        {
            try
            {
                Content = await Http.GetStringAsync(Source);
            }
            catch (Exception ex)
            {
                Content = $"# Error\n\nUnable to load content from '{Source}'.\n\n```\n{ex.Message}\n```";
            }
        }
        if (!string.IsNullOrEmpty(Content))
        {
            //使用markdig或其他js库进行转换
            MarkdownContent = await Mds.ConvertToHtmlAsync(Content);
        }
        else
        {
            MarkdownContent = string.Empty;
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 确保 Prism.js 处理动态内容
        //TODO Bug: 语言名称会置顶，悬浮在其他元素上方，遮挡部分内容，待解决
        await JSRuntime.InvokeVoidAsync("prismFunctions.highlightAll");
    }

}

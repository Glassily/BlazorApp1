@page "/markdown-demo"
@using BlazorApp1.Services
@using BlazorApp1.Components
@inject IJSRuntime JSRuntime

<div class="markdown-demo-container">
    <div class="header">
        <h1>✨ Markdown 编辑器</h1>
        <div class="toolbar">
            <button class="btn btn-clear" @onclick="changeValue">
                <span>⌫</span> 清空
            </button>
            <button class="btn btn-save" @onclick="saveMarkdowan">
                <span>💾</span> 保存为 .md
            </button>
        </div>
    </div>

    <div class="editor-grid">
        <div class="panel editor-panel">
            <div class="panel-header">✏️ 编辑区</div>
            <div class="panel-content">
                <MarkdownInput @bind-Value="markdownText" />
            </div>
        </div>

        <div class="panel preview-panel">
            <div class="panel-header">👀 实时预览</div>
            <div class="panel-content preview-content">
                <MarkdownPreview Content="@markdownText" />
            </div>
        </div>
    </div>

    <div class="footer">
        <span class="hint">💡 小提示：支持 GitHub 风格 Markdown 语法 | 按 Ctrl+S 快速保存</span>
    </div>
</div>

<style>
    .markdown-demo-container {
        max-width: 1400px;
        margin: 1.5rem auto;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        color: #333;
        padding: 0 1.5rem;
    }

    /* 顶部标题栏 */
    .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

        .header h1 {
            font-size: 1.8rem;
            background: linear-gradient(45deg, #6366f1, #8b5cf6, #ec4899);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

    .toolbar {
        display: flex;
        gap: 0.75rem;
    }

    /* 按钮样式 */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0.65rem 1.25rem;
        border: none;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 2px 6px rgba(0,0,0,0.12);
        font-size: 0.95rem;
    }

        .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }

        .btn:active {
            transform: translateY(0);
        }

    .btn-clear {
        background: linear-gradient(to right, #ef4444, #f87171);
        color: white;
    }

        .btn-clear:hover {
            background: linear-gradient(to right, #dc2626, #ef4444);
        }

    .btn-save {
        background: linear-gradient(to right, #10b981, #34d399);
        color: white;
    }

        .btn-save:hover {
            background: linear-gradient(to right, #0da271, #10b981);
        }

    /* 编辑器网格布局 */
    .editor-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        height: calc(100vh - 220px);
        min-height: 500px;
    }

    .panel {
        display: flex;
        flex-direction: column;
        border-radius: 14px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        background: white;
        border: 1px solid #e2e8f0;
    }

    .panel-header {
        padding: 0.9rem 1.25rem;
        background: linear-gradient(to right, #f8fafc, #f1f5f9);
        font-weight: 600;
        color: #4b5563;
        border-bottom: 1px solid #e2e8f0;
        font-size: 1.05rem;
        display: flex;
        align-items: center;
    }

        .panel-header::before {
            content: "";
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 8px;
        }

    .editor-panel .panel-header::before {
        background: #f56565;
    }

    .preview-panel .panel-header::before {
        background: #48bb78;
    }

    .panel-content {
        flex: 1;
        padding: 1.25rem;
        overflow: auto;
        line-height: 1.6;
    }

    .editor-panel .panel-content {
        padding: 0;
    }

    .editor-panel textarea {
        width: 100%;
        height: 100%;
        border: none;
        padding: 1.25rem;
        font-family: 'Fira Code', 'Consolas', monospace;
        font-size: 0.95rem;
        line-height: 1.6;
        resize: none;
        outline: none;
        background-color: #fafbfc;
        color: #2d3748;
        transition: background-color 0.3s;
    }

        .editor-panel textarea:focus {
            background-color: #f8fafc;
        }

    .preview-content {
        background-color: #fcfdfe;
        color: #334155;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

        .preview-content h1, .preview-content h2, .preview-content h3 {
            margin-top: 1.4em;
            margin-bottom: 0.6em;
            line-height: 1.3;
        }

        .preview-content h1 {
            font-size: 1.8em;
            border-bottom: 2px solid #e2e8f0;
            padding-bottom: 0.3em;
        }

        .preview-content h2 {
            font-size: 1.5em;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 0.2em;
        }

        .preview-content p, .preview-content ul, .preview-content ol {
            margin-bottom: 1.1em;
        }

        .preview-content ul, .preview-content ol {
            padding-left: 1.8em;
        }

        .preview-content a {
            color: #4338ca;
            text-decoration: none;
            transition: opacity 0.2s;
        }

            .preview-content a:hover {
                opacity: 0.85;
                text-decoration: underline;
            }

        .preview-content code {
            background-color: #f1f5f9;
            padding: 0.2em 0.4em;
            border-radius: 4px;
            font-family: 'Fira Code', monospace;
            font-size: 0.92em;
        }

        .preview-content pre {
            background-color: #1e293b;
            color: #e2e8f0;
            padding: 1.2em;
            border-radius: 8px;
            overflow-x: auto;
            margin: 1.2em 0;
            font-family: 'Fira Code', monospace;
            font-size: 0.9em;
        }

        .preview-content blockquote {
            border-left: 3px solid #4f46e5;
            background-color: #f9fafb;
            padding: 0.8em 1.2em;
            margin: 1.2em 0;
            color: #4b5563;
            border-radius: 0 6px 6px 0;
        }

        .preview-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 1.2em 0;
        }

        .preview-content th, .preview-content td {
            border: 1px solid #e2e8f0;
            padding: 0.6em 1em;
            text-align: left;
        }

        .preview-content th {
            background-color: #f8fafc;
            font-weight: 600;
        }

    /* 底部提示 */
    .footer {
        margin-top: 1.5rem;
        text-align: center;
        color: #64748b;
        font-size: 0.9rem;
        padding-top: 0.75rem;
        border-top: 1px dashed #cbd5e1;
    }

    .hint {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    /* 响应式设计 */
    @@media (max-width: 900px) {
        .editor-grid {
            grid-template-columns: 1fr;
            height: auto;
        }

        .panel {
            min-height: 400px;
        }

        .header {
            flex-direction: column;
            align-items: flex-start;
        }

        .toolbar {
            width: 100%;
            justify-content: flex-end;
        }
    }
    @@media (max-width: 480px) {
        .btn {
            padding: 0.55rem 1rem;
            font-size: 0.9rem;
        }

        .header h1 {
            font-size: 1.5rem;
        }

        .panel-header {
            font-size: 1rem;
            padding: 0.75rem 1rem;
        }

        .footer .hint {
            font-size: 0.85rem;
            flex-direction: column;
        }
    }

    /* 滚动条美化 */
    .panel-content::-webkit-scrollbar {
        width: 8px;
    }

    .panel-content::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 4px;
    }

    .panel-content::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 4px;
        transition: background 0.3s;
    }

        .panel-content::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
</style>

@code {
    private string markdownText = "# 你好，Markdown!\n\n- ✨ **实时预览** 支持\n- 📝 编辑内容\n- 💾 一键保存为 .md 文件\n\n```csharp\n// 示例代码块\nvar message = \"Hello Blazor!\";\nConsole.WriteLine(message);\n```\n\n> 这是一个引用区块，设计得清晰易读";

    private void changeValue()
    {
        markdownText = "";
    }

    private async Task saveMarkdowan()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("saveTextAsFile", "markdown-content.md", markdownText);
        }
        catch (JSException ex) when (ex.Message.Contains("AbortError"))
        {
            // 用户取消保存，静默处理
        }
        catch (Exception ex)
        {
            Console.WriteLine($"保存失败: {ex.Message}");
            // 实际项目中建议使用通知组件提示用户
        }
    }
}
@page "/markdown-demo"
@using BlazorApp1.Services
@using BlazorApp1.Components

<MarkdownInput @bind-Value="markdownText"/>
<button onclick="@changeValue">修改内容</button>
<!-- 可选：实时预览区域 -->
<MarkdownPreview Content="@markdownText" />

@code {

    private string markdownText = "# 你好，Markdown!\n\n- 编辑内容\n- 实时预览";

    private void changeValue()
    {
        markdownText = "# 已修改内容\n\n这是通过按钮修改的内容。\n\n- 新项目 1\n- 新项目 2\n\n```csharp\nConsole.WriteLine(\"内容已修改\");\n```";
    }
}